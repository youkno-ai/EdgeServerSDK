{
  "name": "@youkno/sdk",
  "version": "1.20.2332",
  "description": "Belong Edge Server TypeScript SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
